{
  "name": "@apidrifter/core",
  "version": "0.1.0",
  "description": "Pure, deterministic breaking-change engine for OpenAPI documents and MCP servers. No I/O.",
  "keywords": [
    "openapi",
    "mcp",
    "api",
    "diff",
    "breaking-changes",
    "contract-testing",
    "json-schema",
    "verification"
  ],
  "license": "Apache-2.0",
  "author": "apidrifter",
  "homepage": "https://apidrifter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apidrifter/apidrifter.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/apidrifter/apidrifter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
