---
import Base from "../../layouts/Base.astro";
import { breadcrumbs } from "../../lib/jsonld";
import { SITE, isoDate } from "../../lib/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("research", (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const jsonld = [
  breadcrumbs([
    { name: SITE.name, url: `${SITE.url}/` },
    { name: "Research", url: `${SITE.url}/research/` },
  ]),
];
---

<Base
  title="Research: public APIs vs their specs"
  description="Investigations into how published OpenAPI specs compare with live API behavior, each with the exact requests sent, raw findings and reproducible data."
  jsonld={jsonld}
>
  <h1>Research</h1>
  <p class="muted">
    What we find when we point the tool at the real world. Every post ships with its data and
    the exact requests sent. <a href="/research/rss.xml">RSS</a> &middot;
    <a href="/llms-full.txt">full text for agents</a>
  </p>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <h2>
            <a href={`/research/${p.id}/`}>{p.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time>
          </p>
          <p>{p.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
