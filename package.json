{
  "name": "apidrifter-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Breaking-change detection and monitoring for OpenAPI documents and MCP servers.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "rules:docs": "node packages/core/dist/scripts/generate-rules-doc.js > docs/rules.md",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vite": "8.3.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.2"
    }
  }
}
