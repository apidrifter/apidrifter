---
import Logo from "../components/Logo.astro";
import { type JsonLd, serializeJsonLd } from "../lib/jsonld";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Use the wide content column (tables). */
  wide?: boolean;
  /** Render the title as given, without the site suffix (home page). */
  bareTitle?: boolean;
  /** Structured data blocks for this page. */
  jsonld?: JsonLd[];
  /** Path of a Markdown twin of this page, if one exists. */
  markdownAlternate?: string;
  /** Article dates for Open Graph, ISO strings. */
  article?: { published: string; modified: string };
}

const {
  title,
  description,
  wide = false,
  bareTitle = false,
  jsonld = [],
  markdownAlternate,
  article,
} = Astro.props;
const fullTitle = bareTitle || title === SITE.name ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL("/og-default.png", SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="API Drifter research" href="/research/rss.xml" />
    {markdownAlternate !== undefined && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}
    <meta property="og:type" content={article !== undefined ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="API Drifter logo" />
    <meta property="og:locale" content="en_US" />
    {
      article !== undefined && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:modified_time" content={article.modified} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#080712" />
    {jsonld.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(jsonld)} />}
  </head>
  <body>
    <header class="site">
      <div class="wrap wrap--wide">
        <Logo />
        <nav aria-label="Primary">
          <a href="/research/">Research</a>
          <a href="/drift-index/">Drift index</a>
          <a href="/agents/">Agents</a>
          <a href="/changes/">Changes</a>
          <a href="/docs/cli/">Docs</a>
          <a href={SITE.repo} rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>
    <main>
      <div class:list={["wrap", { "wrap--wide": wide }]}>
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap wrap--wide">
        <span>{SITE.name} &middot; Apache-2.0 &middot; <a href={SITE.repo} rel="noopener">Source on GitHub</a> &middot; <a href={SITE.npm} rel="noopener">apidrifter on npm</a></span>
        <span><a href="/research/">Research</a> &middot; <a href="/changes/">Changes</a> &middot; <a href="/drift-index/">Drift index</a> &middot; <a href="/compare/">Compare</a> &middot; <a href="/agents/">Agents</a> &middot; <a href="/docs/cli/">CLI</a> &middot; <a href="/docs/rules/">Rules</a> &middot; <a href="/docs/design/">Design</a> &middot; <a href="/llms.txt">llms.txt</a> &middot; <a href="/llms-full.txt">llms-full.txt</a></span>
      </div>
    </footer>
  </body>
</html>
