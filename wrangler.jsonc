{
  // Cloudflare Workers config for the public site: static assets only, no worker code.
  // Build: pnpm --filter @apidrifter/web build   Deploy: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apidrifter",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
