---
import Finding from "../../../../components/Finding.astro";
import Base from "../../../../layouts/Base.astro";
import { SITE } from "../../../../lib/site";
import { GROUPS, groupFindings, loadFindings, loadSummary, type SurveyApi } from "../../../../lib/survey";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("research", (p) => !p.data.draft && p.data.survey);
  const summary = await loadSummary();
  const paths = [];
  for (const post of posts) {
    for (const api of summary.apis) {
      paths.push({
        params: { slug: post.id, api: api.id },
        props: { post, api, generatedAt: summary.generatedAt },
      });
    }
  }
  return paths;
}

interface Props {
  post: { id: string; data: { title: string } };
  api: SurveyApi;
  generatedAt: string;
}

const { post, api, generatedAt } = Astro.props;
const findings = await loadFindings(api.id);
const groups = groupFindings(findings);
const title = `${api.name}: spec vs live`;
const description = `${api.counts.hard} hard violations on successful responses out of ${api.sent} requests sent. Every request and finding, with fixes for both sides.`;
---

<Base title={title} description={description} wide>
  <p class="post-meta">
    <a href="/research/">Research</a> &middot; <a href={`/research/${post.id}/`}>{post.data.title}</a>
  </p>
  <h1>{api.name}</h1>

  <dl class="facts">
    <dt>Spec</dt>
    <dd><a href={api.spec} rel="noopener nofollow">{api.spec}</a> ({api.specFormat === "swagger-2.0" ? "Swagger 2.0, converted to OpenAPI 3 before checking" : "OpenAPI 3"})</dd>
    <dt>Base URL</dt>
    <dd><code>{api.baseUrl}</code></dd>
    <dt>Run</dt>
    <dd>{(api.ranAt ?? generatedAt).slice(0, 10)}, read-only GET requests, no credentials</dd>
    <dt>Coverage</dt>
    <dd>
      {api.operations} operations in the spec, {api.sent} requests sent, {api.ok} successful,
      {api.observed} operations observed
    </dd>
    <dt>Hard violations</dt>
    <dd><strong>{api.counts.hard}</strong> distinct schema locations</dd>
    <dt>Reviewer note</dt>
    <dd>{api.note}</dd>
  </dl>

  {
    GROUPS.map((g) => {
      const list = groups.get(g.key) ?? [];
      if (list.length === 0) return null;
      return (
        <details class="group" open={g.open}>
          <summary>
            <span>{g.label}</span>
            <span class="count">{list.length}</span>
            <span class="blurb">{g.blurb}</span>
          </summary>
          {list.map((f) => (
            <Finding finding={f} />
          ))}
        </details>
      );
    })
  }

  <p class="small muted">
    Raw data: <a href={`${SITE.resultsUrl}/${api.id}.findings.json`} rel="noopener">findings</a> and
    <a href={`${SITE.resultsUrl}/${api.id}.observations.json`} rel="noopener">requests sent</a>.
    Reproduce with <code>apidrifter run</code>; the target definition is in <code>tools/survey/targets.json</code>.
    If a finding is wrong, open an issue; if it is right, a pull request on the spec is welcome.
  </p>
</Base>
