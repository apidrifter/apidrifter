{
  "openapi": "3.1.0",
  "info": {
    "title": "Pets",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "post": {
        "operationId": "createPet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "nickname": {
                    "type": "string"
                  },
                  "count": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b",
                      "c"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "nickname": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nickname"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
