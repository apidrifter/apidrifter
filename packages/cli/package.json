{
  "name": "apidrifter",
  "version": "0.2.0",
  "mcpName": "com.apidrifter/apidrifter",
  "description": "Diff OpenAPI documents and MCP servers, classify breaking changes, fail CI.",
  "keywords": [
    "openapi",
    "mcp",
    "api",
    "cli",
    "diff",
    "breaking-changes",
    "contract-testing",
    "spec-drift",
    "verification"
  ],
  "license": "Apache-2.0",
  "author": "apidrifter",
  "homepage": "https://apidrifter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apidrifter/apidrifter.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/apidrifter/apidrifter/issues"
  },
  "type": "module",
  "bin": {
    "apidrifter": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidrifter/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
